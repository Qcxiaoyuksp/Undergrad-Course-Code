<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!--背景图片-->
    <ImageView
        android:id="@+id/image_view_bg"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/img_bg" />
    <!--头像图片-->
    <ImageView
        android:id="@+id/image_view_face"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="212dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="@+id/image_view_bg"
        app:layout_constraintTop_toTopOf="@+id/image_view_bg"
        app:srcCompat="@mipmap/img_face" />
    <!--昵称-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="20dp"
        android:text="沉睡的海螺"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@+id/image_view_face"
        app:layout_constraintTop_toTopOf="@+id/image_view_face" />
</androidx.constraintlayout.widget.ConstraintLayout>